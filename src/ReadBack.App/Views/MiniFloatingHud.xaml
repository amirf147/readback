<Window x:Class="ReadBack.App.Views.MiniFloatingHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReadBack.App.ViewModels"
        mc:Ignorable="d"
        Title="ReadBack Floating Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern Pill Action Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38383D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Floating capsule container inspired by Windows 11 Dictation (Win+H) toolbar -->
    <Border CornerRadius="22"
            Background="#E618181B"
            BorderBrush="#3B82F6"
            BorderThickness="1.5"
            Margin="10"
            Padding="12,7"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Active Wave / Mic Badge -->
            <Border Width="30" Height="30" CornerRadius="15" Background="#1D4ED8" Margin="0,0,10,0">
                <TextBlock Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Brand & Progress Pill -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ReadBack"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="#60A5FA"
                               Margin="0,0,6,0"/>
                    <Border Background="#27272A" CornerRadius="8" Padding="5,1">
                        <TextBlock Text="{Binding ChunkProgress}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="#F4F4F5"/>
                    </Border>
                </StackPanel>

                <!-- Current text snippet preview -->
                <TextBlock Text="{Binding SnippetText}"
                           FontSize="12"
                           Foreground="#D4D4D8"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Control Buttons (Prev, Play/Pause, Next, Stop) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <!-- Previous Chunk -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding PrevCommand}"
                        ToolTip="Previous Paragraph (Ctrl+Alt+Left)"
                        Width="30" Height="28">
                    <TextBlock Text="⏮" FontSize="11"/>
                </Button>

                <!-- Play / Pause -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding PlayPauseCommand}"
                        ToolTip="Pause / Resume (Ctrl+Alt+Space)"
                        Width="32" Height="28">
                    <TextBlock Text="{Binding IsPlaying, Converter={x:Null}}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⏸"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="▶"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Next Chunk -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding NextCommand}"
                        ToolTip="Next Paragraph (Ctrl+Alt+Right)"
                        Width="30" Height="28">
                    <TextBlock Text="⏭" FontSize="11"/>
                </Button>

                <!-- Stop -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding StopCommand}"
                        ToolTip="Stop Narration (Ctrl+Alt+X or Esc)"
                        Width="30" Height="28">
                    <TextBlock Text="⏹" FontSize="11" Foreground="#EF4444"/>
                </Button>

                <!-- Close / Hide -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding CloseCommand}"
                        ToolTip="Hide HUD"
                        Width="26" Height="28" Margin="4,0,0,0">
                    <TextBlock Text="✕" FontSize="10" Foreground="#A1A1AA"/>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
